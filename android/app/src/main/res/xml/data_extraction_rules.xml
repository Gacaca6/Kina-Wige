<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to cloud backup. Device-to-device transfer is left
     at its default, so a family moving to a new phone keeps the child's progress
     without it passing through anyone's servers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
