---
// Latin subsets only. The full packages also ship Hebrew, Cyrillic and
// Vietnamese, which Kinyarwanda, English and French will never ask for — they
// only bloated the inlined CSS.
import '@fontsource/fredoka/latin-400.css';
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/fredoka/latin-700.css';
import '@fontsource/nunito/latin-600.css';
import '@fontsource/nunito/latin-800.css';
import '@fontsource/nunito/latin-ext-600.css';
import '../styles/global.css';

import { COPY, LOCALES, type Locale } from '../i18n/copy';
import { APP_URL, SITE_ORIGIN } from '../config';
import Imigongo from '../components/Imigongo.astro';

interface Props { locale: Locale; page?: 'home' | 'doc'; title?: string; description?: string }
const { locale, page = 'home', title, description } = Astro.props;
const t = COPY[locale];
const here = LOCALES.find((l) => l.code === locale)!;
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;
const base = here.href;
const doc = (name: string) => (locale === 'en' ? `/${name}/` : `${base}${name}/`);
---

<!doctype html>
<html lang={here.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE_ORIGIN).href} />

    {/* Three real pages, one per language — so a search engine can index each
        and a visitor downloads only the language they asked for. */}
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l.htmlLang} href={new URL(l.href, SITE_ORIGIN).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={SITE_ORIGIN} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={new URL('/assets/og.png', SITE_ORIGIN).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Kina Wige" />
    <meta property="og:locale" content={here.htmlLang} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#17543C" />
    <link rel="icon" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    {/* Structured data. Deliberately claims nothing we cannot back: no rating,
        no download count, no award. Price is genuinely 0. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Kina Wige',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Android, iOS, Web',
      inLanguage: ['rw', 'en', 'fr'],
      audience: { '@type': 'EducationalAudience', educationalRole: 'student', audienceType: 'Children aged 3-6' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'RWF' },
      description: pageDesc,
      url: SITE_ORIGIN,
    })} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={base}>
          <img src="/assets/icon.png" alt="" width="40" height="40" />
          <span>Kina&nbsp;Wige</span>
        </a>

        {page === 'home' && (
          <nav class="site-nav" aria-label="Sections">
            <a href="#how">{t.nav.how}</a>
            <a href="#learn">{t.nav.learn}</a>
            <a href="#parents">{t.nav.parents}</a>
            <a href="#schools">{t.nav.schools}</a>
          </nav>
        )}

        <div class="head-right">
          {/* Real links, not a JS toggle — each language is its own page. */}
          <div class="lang" role="group" aria-label="Language">
            {LOCALES.map((l) => (
              <a href={l.href} aria-current={l.code === locale ? 'true' : undefined}>{l.label}</a>
            ))}
          </div>
          <a class="btn btn-sun head-cta" href={APP_URL}>{t.nav.install}</a>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <Imigongo tone="grass" height={22} />
      <div class="wrap foot-inner">
        <div class="foot-grid">
          <div>
            <a class="brand brand-foot" href={base}>
              <img src="/assets/icon.png" alt="" width="44" height="44" />
              <span>Kina&nbsp;Wige</span>
            </a>
            <p class="foot-tag">{t.foot.tagline}</p>
          </div>
          <div>
            <h4>{t.foot.product}</h4>
            <ul>
              <li><a href={`${base}#how`}>{t.foot.links.how}</a></li>
              <li><a href={`${base}#learn`}>{t.foot.links.learn}</a></li>
              <li><a href={`${base}#parents`}>{t.foot.links.parents}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t.foot.company}</h4>
            <ul>
              <li><a href={`${base}#schools`}>{t.foot.links.schools}</a></li>
              <li><a href={doc('privacy')}>{t.foot.links.privacy}</a></li>
              <li><a href={doc('terms')}>{t.foot.links.terms}</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-legal">
          <span>© {new Date().getFullYear()} Kina Wige. {t.foot.rights}</span>
          <span class="foot-made">🇷🇼 {t.foot.madeIn}</span>
        </div>
      </div>
    </footer>

    <style>
      .head-inner { display: flex; align-items: center; gap: clamp(0.75rem, 2vw, 1.75rem); min-height: 74px; }
      .site-head {
        position: sticky; top: 0; z-index: 60;
        background: color-mix(in oklab, var(--paper) 92%, transparent);
        border-bottom: 3px solid var(--edge);
      }
      @supports (backdrop-filter: blur(6px)) { .site-head { backdrop-filter: saturate(1.4) blur(6px); } }

      .brand {
        display: inline-flex; align-items: center; gap: 0.6rem;
        font-family: Fredoka, sans-serif; font-weight: 600; font-size: 1.24rem;
        text-decoration: none; color: var(--ink); letter-spacing: -0.02em;
      }
      .brand img { border-radius: 11px; }

      .site-nav { display: flex; gap: clamp(0.9rem, 2vw, 1.7rem); margin-inline-start: auto; }
      .site-nav a { font-size: 0.97rem; font-weight: 700; color: var(--ink-soft); text-decoration: none; }
      .site-nav a:hover { color: var(--forest); }
      @media (max-width: 960px) { .site-nav { display: none; } }

      .head-right { display: flex; align-items: center; gap: 0.7rem; margin-inline-start: auto; }
      .site-nav ~ .head-right { margin-inline-start: 0; }

      .lang { display: flex; gap: 2px; background: var(--sand); border-radius: 12px; padding: 3px; }
      .lang a {
        font-family: Fredoka, sans-serif; font-weight: 600; font-size: 0.8rem;
        color: var(--ink-muted); text-decoration: none;
        padding: 0.45rem 0.6rem; border-radius: 9px; min-width: 40px; text-align: center;
      }
      .lang a[aria-current='true'] { background: var(--forest); color: var(--paper); }

      .head-cta { min-height: 46px; padding: 0.55em 1.15em; font-size: 0.95rem; border-radius: 13px; box-shadow: 0 4px 0 var(--sun-deep); }
      @media (max-width: 560px) { .head-cta { display: none; } }

      .site-foot { background: var(--forest-ink); color: var(--mint); }
      .foot-inner { padding-block: clamp(2.5rem, 5vw, 4rem) 2rem; }
      .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); }
      @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-grid > :first-child { grid-column: 1 / -1; } }
      .brand-foot { color: var(--paper); font-size: 1.35rem; }
      .foot-tag { margin-top: 0.9rem; max-width: 34ch; font-size: 0.95rem; color: color-mix(in oklab, var(--mint) 78%, transparent); }
      .site-foot h4 {
        font-family: Fredoka, sans-serif; font-size: 0.76rem; letter-spacing: 0.16em;
        text-transform: uppercase; color: var(--mint-deep); margin: 0 0 0.9rem;
      }
      .site-foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
      .site-foot a { color: var(--paper); text-decoration: none; font-size: 0.95rem; font-weight: 600; }
      .site-foot ul a:hover { text-decoration: underline; text-underline-offset: 4px; }
      .foot-legal {
        margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.3rem;
        border-top: 2px solid color-mix(in oklab, var(--mint) 18%, transparent);
        display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between;
        font-size: 0.86rem; color: color-mix(in oklab, var(--mint) 72%, transparent);
      }
      .foot-made { font-weight: 800; }
    </style>
  </body>
</html>
