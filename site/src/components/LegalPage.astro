---
import Base from '../layouts/Base.astro';
import { PRIVACY, TERMS } from '../i18n/legal';
import { CONTACT_EMAIL } from '../config';
import type { Locale } from '../i18n/copy';

interface Props { locale: Locale; doc: 'privacy' | 'terms' }
const { locale, doc } = Astro.props;
const d = (doc === 'privacy' ? PRIVACY : TERMS)[locale];
---

<Base locale={locale} page="doc" title={`${d.title} — Kina Wige`} description={d.intro}>
  <article class="bay ground-paper">
    <div class="wrap-narrow doc">
      <h1>{d.title}</h1>
      <p class="updated">{d.updated}</p>
      <p class="lede">{d.intro}</p>

      {d.blocks.map((b) => (
        <section class="doc-block">
          <h2>{b.h}</h2>
          {b.p && <p>{b.p}</p>}
          {b.ul && <ul>{b.ul.map((li) => (<li>{li}</li>))}</ul>}
        </section>
      ))}

      <p class="doc-mail"><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    </div>
  </article>
</Base>

<style>
  .doc h1 { font-size: var(--step-4); }
  .updated { font-size: 0.92rem; font-weight: 800; color: var(--ink-muted); margin-bottom: 1.6rem; }
  .doc .lede { font-size: var(--step-1); margin-bottom: 2.4rem; }
  .doc-block { margin-bottom: 2.2rem; }
  .doc-block h2 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .doc-block p { color: var(--ink-soft); max-width: 68ch; }
  .doc-block ul { margin: 0.6rem 0 0; padding-inline-start: 1.15rem; color: var(--ink-soft); display: grid; gap: 0.45rem; }
  .doc-mail { margin-top: 3rem; font-weight: 800; }
</style>
