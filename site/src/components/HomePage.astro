---
import Base from '../layouts/Base.astro';
import Imigongo from './Imigongo.astro';
import Phone from './Phone.astro';
import StoreBadges from './StoreBadges.astro';
import { COPY, type Locale } from '../i18n/copy';
import { APP_URL, CONTACT_EMAIL } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = COPY[locale];

const DOMAIN_TONE = ['sun', 'sky', 'grass', 'coral', 'grape', 'forest'] as const;
const SECTION_ICON: Record<string, string> = { learn: '▤', video: '▶', play: '◉', book: '❑' };
---

<Base locale={locale}>
  <!-- ══ HERO ══════════════════════════════════════════════════════════
       Asymmetric on purpose: the argument carries the weight, the phone
       is evidence beside it. Not a centred hero with a screenshot under. -->
  <section class="hero ground-forest">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-badge rise">🇷🇼 {t.hero.badge}</p>
        <h1 class="rise rise-2">
          {t.hero.h1a}<br /><span class="h1-accent">{t.hero.h1b}</span>
        </h1>
        <p class="lede rise rise-3">{t.hero.lede}</p>

        <div class="hero-cta rise rise-4">
          <a class="btn btn-sun" href={APP_URL}>{t.hero.install}</a>
          <a class="btn btn-quiet hero-watch" href="#film">{t.hero.watch} ↓</a>
        </div>

        <ul class="hero-points rise rise-5">
          {t.hero.points.map((p) => (<li><span class="tick" aria-hidden="true"></span>{p}</li>))}
        </ul>

        <div class="hero-badges rise rise-5">
          <StoreBadges soonLabel={t.hero.soon} />
        </div>
      </div>

      <div class="hero-art rise rise-3">
        <Phone unit="Karaba amaboko" unitLabel="IGICE" nav={['Iga', 'Amasomo', 'Imikino', 'Ibitabo']} />
      </div>
    </div>
  </section>

  <Imigongo tone="sun" height={40} />

  <!-- ══ FILM ═════════════════════════════════════════════════════════ -->
  <section id="film" class="bay ground-sand">
    <div class="wrap film-head">
      <div>
        <p class="eyebrow">{t.film.eyebrow}</p>
        <h2>{t.film.h2}</h2>
      </div>
      <p class="lede">{t.film.lede}</p>
    </div>
    <div class="wrap">
      <figure class="film-frame reveal">
        {/* preload="none": nine megabytes are downloaded only if someone asks. */}
        <video controls preload="none" playsinline poster="/assets/episode-poster.webp" width="1280" height="720">
          <source src="/media/isuku.mp4" type="video/mp4" />
          {/* The narration is English. Captions are the honest fix for a
              Kinyarwanda-first product, and they carry the lesson to a deaf
              child or a muted phone at the same time. The visitor's own
              language is the default track. */}
          <track kind="captions" src="/media/captions/isuku.rw.vtt" srclang="rw" label="Ikinyarwanda" default={locale === 'rw'} />
          <track kind="captions" src="/media/captions/isuku.en.vtt" srclang="en" label="English" default={locale === 'en'} />
          <track kind="captions" src="/media/captions/isuku.fr.vtt" srclang="fr" label="Français" default={locale === 'fr'} />
        </video>
        <figcaption>{t.film.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ══ HOW IT WORKS ═════════════════════════════════════════════════
       A staggered editorial list, not four identical icon cards. The
       Kinyarwanda name is the headline — that is the product's own voice. -->
  <section id="how" class="bay ground-paper">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2>{t.how.h2}</h2>
        <p class="lede">{t.how.lede}</p>
      </div>

      <ol class="how-list">
        {t.how.items.map((it, i) => (
          <li class="how-item reveal" style={`--tone: var(--${DOMAIN_TONE[i]}); --tone-deep: var(--${['sun-deep','sky-deep','grass-deep','coral-deep'][i]})`}>
            <span class="how-mark" aria-hidden="true">{SECTION_ICON[it.icon]}</span>
            <div class="how-body">
              <h3><span class="how-kn">{it.kn}</span><span class="how-en">{it.name}</span></h3>
              <p>{it.body}</p>
            </div>
            <span class="how-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══ WHAT THEY LEARN ══════════════════════════════════════════════ -->
  <section id="learn" class="bay ground-forest">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.learn.eyebrow}</p>
        <h2>{t.learn.h2}</h2>
        <p class="lede">{t.learn.lede}</p>
      </div>

      <div class="domains">
        {t.learn.domains.map((d, i) => (
          <article class="domain reveal" style={`--dot: var(--${DOMAIN_TONE[i]})`}>
            <span class="domain-dot" aria-hidden="true"></span>
            <h3>{d.name}</h3>
            <p>{d.body}</p>
          </article>
        ))}
      </div>

      <div class="bands reveal">
        <div class="bands-copy">
          <h3>{t.learn.bandsTitle}</h3>
          <p>{t.learn.bandsLede}</p>
        </div>
        <ul class="bands-list">
          {t.learn.bands.map((b) => (
            <li>
              <span class="b-ico" aria-hidden="true">{b.icon}</span>
              <span class="b-name">{b.name}</span>
              <span class="b-what">{b.what}</span>
            </li>
          ))}
        </ul>
      </div>

      <p class="contract reveal">{t.learn.contract}</p>
    </div>
  </section>

  <Imigongo tone="forest" height={34} flip />

  <!-- ══ FOR PARENTS ══════════════════════════════════════════════════ -->
  <section id="parents" class="bay ground-paper">
    <div class="wrap parents-grid">
      <div>
        <p class="eyebrow">{t.parents.eyebrow}</p>
        <h2>{t.parents.h2}</h2>
        <p class="lede">{t.parents.lede}</p>

        <div class="parent-cards reveal">
          {t.parents.cards.map((c) => (
            <article class="pcard">
              <h4>{c.title}</h4>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>

      <aside class="report reveal" aria-label={t.parents.reportTitle}>
        <p class="report-head">{t.parents.reportTitle}</p>
        {t.parents.rows.map((r) => (
          <div class="report-row">
            <b>{r.band}</b>
            <span>{r.skill}</span>
          </div>
        ))}
        <p class="report-foot">🔒 {t.privacy.no[3]}</p>
      </aside>
    </div>
  </section>

  <!-- ══ OFFLINE ══════════════════════════════════════════════════════ -->
  <section class="bay ground-mint">
    <div class="wrap offline-grid">
      <div>
        <p class="eyebrow">{t.offline.eyebrow}</p>
        <h2>{t.offline.h2}</h2>
        <p class="lede">{t.offline.lede}</p>
      </div>
      <dl class="stats reveal">
        {t.offline.stats.map((s) => (
          <div class="stat">
            <dt>{s.n}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ══ PRIVACY ══════════════════════════════════════════════════════ -->
  <section class="bay ground-paper">
    <div class="wrap">
      <div class="sec-head sec-head-narrow">
        <p class="eyebrow">{t.privacy.eyebrow}</p>
        <h2>{t.privacy.h2}</h2>
        <p class="lede">{t.privacy.lede}</p>
      </div>
      <div class="privacy-grid">
        <div class="pbox pbox-yes">
          <h3>{t.privacy.yesTitle}</h3>
          <ul>{t.privacy.yes.map((y) => (<li>{y}</li>))}</ul>
        </div>
        <div class="pbox pbox-no">
          <h3>{t.privacy.noTitle}</h3>
          <ul>{t.privacy.no.map((n) => (<li>{n}</li>))}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ LANGUAGES ════════════════════════════════════════════════════ -->
  <section class="bay ground-sand">
    <div class="wrap lang-grid">
      <div class="lang-words reveal" aria-hidden="true">
        <span>Kina wige</span>
        <span>Play and learn</span>
        <span>Joue et apprends</span>
      </div>
      <div>
        <p class="eyebrow">{t.langs.eyebrow}</p>
        <h2>{t.langs.h2}</h2>
        <p class="lede">{t.langs.lede}</p>
        <p class="lang-note">{t.langs.note}</p>
      </div>
    </div>
  </section>

  <!-- ══ SCHOOLS & PARTNERS ═══════════════════════════════════════════ -->
  <section id="schools" class="bay ground-forest">
    <div class="wrap schools-grid">
      <div>
        <p class="eyebrow">{t.schools.eyebrow}</p>
        <h2>{t.schools.h2}</h2>
        <p class="lede">{t.schools.lede}</p>
      </div>
      <div class="schools-cta reveal">
        <p>{t.schools.body}</p>
        <a class="btn btn-sun" href={`mailto:${CONTACT_EMAIL}`}>{t.schools.cta}</a>
      </div>
    </div>
  </section>

  <!-- ══ CREDITS ══════════════════════════════════════════════════════ -->
  <section class="bay ground-paper credits">
    <div class="wrap-narrow">
      <p class="eyebrow">{t.credits.eyebrow}</p>
      <h2>{t.credits.h2}</h2>
      <p class="lede">{t.credits.body}</p>
    </div>
  </section>

  <!-- ══ FAQ ══════════════════════════════════════════════════════════ -->
  <section class="bay ground-sand">
    <div class="wrap-narrow">
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2>{t.faq.h2}</h2>
      <div class="faq-list reveal">
        {t.faq.items.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Imigongo tone="sand" height={34} />

  <!-- ══ CLOSING CTA ══════════════════════════════════════════════════ -->
  <section class="bay ground-forest final">
    <div class="wrap-narrow">
      <h2>{t.cta.h2}</h2>
      <p class="lede">{t.cta.lede}</p>
      <div class="final-actions">
        <a class="btn btn-sun" href={APP_URL}>{t.cta.install}</a>
      </div>
      <div class="final-badges"><StoreBadges soonLabel={t.hero.soon} /></div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ───────────────────────────────────────────────────────── */
  .hero { padding-block: clamp(3rem, 7vw, 6.5rem) clamp(3.5rem, 8vw, 7rem); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  @media (max-width: 940px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { order: -1; } }

  .hero-badge {
    display: inline-block; font-weight: 800; font-size: 0.9rem;
    letter-spacing: 0.05em; color: var(--sun);
    background: color-mix(in oklab, var(--sun) 15%, transparent);
    padding: 0.45rem 0.95rem; border-radius: 999px; margin: 0 0 1.3rem;
  }
  .hero h1 { margin-bottom: 0.55em; }
  .h1-accent {
    color: var(--sun);
    /* A hand-drawn underline rather than a gradient — it belongs to the
       flat, printed language the rest of the brand speaks. */
    background-image: linear-gradient(var(--grass), var(--grass));
    background-size: 100% 0.14em; background-position: 0 92%; background-repeat: no-repeat;
    padding-bottom: 0.06em;
  }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem; margin-block: 2rem 1.6rem; }
  .hero-watch { color: var(--mint); }
  .hero-watch:hover { color: var(--sun); }

  .hero-points { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: 0.65rem; }
  .hero-points li {
    display: flex; gap: 0.7rem; align-items: flex-start;
    font-size: 0.98rem; font-weight: 700;
    color: color-mix(in oklab, var(--mint) 90%, transparent);
  }
  .tick { flex: none; width: 22px; height: 22px; margin-top: 2px; border-radius: 7px; background: var(--grass); position: relative; }
  .tick::after {
    content: ''; position: absolute; inset: 0; margin: auto;
    width: 9px; height: 5px; border-left: 3px solid #fff; border-bottom: 3px solid #fff;
    transform: rotate(-45deg) translate(0, -2px);
  }
  .hero-badges { margin-top: 0.4rem; }
  .hero-art { display: grid; place-items: center; }

  /* ── Section heads ──────────────────────────────────────────────── */
  .sec-head { max-width: 62ch; margin-bottom: clamp(2.2rem, 4vw, 3.4rem); }
  .sec-head-narrow { max-width: 54ch; }

  /* ── Film ───────────────────────────────────────────────────────── */
  .film-head {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    align-items: end; margin-bottom: clamp(1.6rem, 3vw, 2.6rem);
  }
  @media (max-width: 820px) { .film-head { grid-template-columns: 1fr; gap: 0.6rem; } }
  .film-frame { margin: 0; }
  .film-frame video {
    width: 100%; height: auto; display: block; background: var(--ink);
    border: 5px solid var(--ink); border-radius: 26px;
    box-shadow: 0 12px 0 var(--edge-deep);
  }
  .film-frame figcaption {
    margin-top: 1rem; font-size: 0.92rem; font-weight: 700; color: var(--ink-muted);
  }

  /* ── How it works ───────────────────────────────────────────────── */
  .how-list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(0.9rem, 1.6vw, 1.4rem); counter-reset: how; }
  .how-item {
    display: grid; grid-template-columns: auto 1fr auto; align-items: start;
    gap: clamp(1rem, 2.4vw, 2rem);
    background: var(--paper); border: 3px solid var(--edge);
    border-radius: 22px; padding: clamp(1.3rem, 2.6vw, 2rem);
    box-shadow: 0 6px 0 var(--edge-deep);
    transition: transform 0.18s var(--ease-out-quart), box-shadow 0.18s var(--ease-out-quart);
  }
  /* Staggered indent breaks the grid so it reads as a path, not a table. */
  .how-item:nth-child(2) { margin-inline-start: clamp(0px, 3vw, 46px); }
  .how-item:nth-child(3) { margin-inline-start: clamp(0px, 6vw, 92px); }
  .how-item:nth-child(4) { margin-inline-start: clamp(0px, 9vw, 138px); }
  @media (max-width: 760px) { .how-item { margin-inline-start: 0 !important; grid-template-columns: auto 1fr; } .how-n { display: none; } }
  .how-item:hover { transform: translateY(-3px); box-shadow: 0 9px 0 var(--edge-deep); }

  .how-mark {
    width: 54px; height: 54px; flex: none; border-radius: 16px;
    background: var(--tone); color: var(--ink);
    display: grid; place-items: center; font-size: 1.5rem;
    box-shadow: 0 4px 0 var(--tone-deep, var(--edge-deep));
  }
  .how-body h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; margin-bottom: 0.35rem; }
  .how-kn { font-size: var(--step-2); }
  .how-en { font-family: Nunito, sans-serif; font-size: 0.86rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; color: var(--ink-muted); }
  .how-body p { color: var(--ink-soft); font-size: 1rem; margin: 0; max-width: 58ch; }
  .how-n { font-family: Fredoka, sans-serif; font-size: 2.4rem; color: var(--edge); line-height: 1; }

  /* ── Domains ────────────────────────────────────────────────────── */
  .domains { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.7rem); }
  @media (max-width: 900px) { .domains { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .domains { grid-template-columns: 1fr; } }
  .domain {
    background: color-mix(in oklab, var(--forest-deep) 78%, transparent);
    border: 2px solid color-mix(in oklab, var(--mint) 16%, transparent);
    border-radius: 18px; padding: 1.4rem 1.5rem;
  }
  .domain-dot { display: block; width: 30px; height: 8px; border-radius: 99px; background: var(--dot); margin-bottom: 1rem; }
  .domain h3 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .domain p { font-size: 0.96rem; margin: 0; }

  /* ── Bands ──────────────────────────────────────────────────────── */
  .bands {
    display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(1.6rem, 4vw, 3.4rem);
    align-items: center; margin-top: clamp(2.4rem, 5vw, 4rem);
    background: var(--forest-ink); border-radius: 26px; padding: clamp(1.6rem, 3.4vw, 2.8rem);
  }
  @media (max-width: 860px) { .bands { grid-template-columns: 1fr; } }
  .bands-copy h3 { font-size: var(--step-2); }
  .bands-copy p { font-size: 0.98rem; margin: 0; }
  .bands-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .bands-list li {
    display: grid; grid-template-columns: 2.2rem 9.5rem 1fr; align-items: center; gap: 0.9rem;
    background: color-mix(in oklab, var(--mint) 8%, transparent);
    border-radius: 13px; padding: 0.75rem 1rem;
  }
  @media (max-width: 520px) { .bands-list li { grid-template-columns: 2.2rem 1fr; } .b-what { grid-column: 2; } }
  .b-ico { font-size: 1.25rem; }
  .b-name { font-family: Fredoka, sans-serif; font-weight: 600; font-size: 1.02rem; color: var(--paper); }
  .b-what { font-size: 0.92rem; color: color-mix(in oklab, var(--mint) 80%, transparent); }

  .contract {
    margin-top: clamp(2rem, 4vw, 3rem); max-width: 68ch;
    font-size: var(--step-1); font-weight: 700;
    border-inline-start: 6px solid var(--sun); padding-inline-start: 1.3rem;
  }

  /* ── Parents ────────────────────────────────────────────────────── */
  .parents-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 4.5vw, 4rem); align-items: start; }
  @media (max-width: 940px) { .parents-grid { grid-template-columns: 1fr; } }
  .parent-cards { display: grid; gap: 0.9rem; margin-top: 2rem; }
  .pcard { background: var(--paper-warm); border-radius: 18px; padding: 1.3rem 1.5rem; border-inline-start: 6px solid var(--grass); }
  .pcard h4 { margin-bottom: 0.3rem; font-size: var(--step-1); }
  .pcard p { font-size: 0.97rem; color: var(--ink-soft); margin: 0; }

  .report {
    background: var(--paper); border: 3px solid var(--sky-line, #90caf9);
    border-radius: 24px; padding: clamp(1.3rem, 2.4vw, 1.9rem);
    box-shadow: 0 8px 0 color-mix(in oklab, var(--sky-ink) 22%, transparent);
    position: sticky; top: 100px;
  }
  @media (max-width: 940px) { .report { position: static; } }
  .report-head {
    font-family: Fredoka, sans-serif; font-size: 0.78rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--sky-ink); margin-bottom: 1.1rem;
  }
  .report-row { background: #f7fafc; border-radius: 14px; padding: 0.85rem 1rem; margin-bottom: 0.6rem; }
  .report-row b { display: block; font-size: 0.93rem; color: #0f2e45; }
  .report-row span { font-size: 0.97rem; color: #3e6d8a; font-weight: 700; }
  .report-foot { margin: 1rem 0 0; font-size: 0.84rem; color: var(--ink-muted); font-weight: 700; }

  /* ── Offline ────────────────────────────────────────────────────── */
  .offline-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 4vw, 3.6rem); align-items: center; }
  @media (max-width: 880px) { .offline-grid { grid-template-columns: 1fr; } }
  .stats { display: grid; gap: 0.8rem; margin: 0; }
  .stat {
    display: flex; align-items: baseline; gap: 1.1rem;
    background: var(--paper); border-radius: 18px; padding: 1.1rem 1.5rem;
    box-shadow: 0 5px 0 var(--edge-deep);
  }
  .stat dt { font-family: Fredoka, sans-serif; font-weight: 700; font-size: var(--step-3); color: var(--forest); line-height: 1; min-width: 3.6rem; }
  .stat dd { margin: 0; font-size: 0.97rem; font-weight: 700; color: var(--ink-soft); }

  /* ── Privacy ────────────────────────────────────────────────────── */
  .privacy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.4vw, 1.8rem); }
  @media (max-width: 760px) { .privacy-grid { grid-template-columns: 1fr; } }
  .pbox { border-radius: 22px; padding: clamp(1.4rem, 2.6vw, 2rem); border: 3px solid; }
  .pbox h3 { font-size: var(--step-1); margin-bottom: 1rem; }
  .pbox ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .pbox li { display: flex; gap: 0.7rem; align-items: flex-start; font-size: 0.98rem; font-weight: 700; }
  .pbox li::before { flex: none; font-weight: 800; }
  .pbox-yes { background: var(--mint); border-color: var(--grass); }
  .pbox-yes li::before { content: '✓'; color: var(--grass-deep); }
  .pbox-no { background: var(--paper-warm); border-color: var(--edge-deep); }
  .pbox-no li::before { content: '✕'; color: var(--coral-deep); }

  /* ── Languages ──────────────────────────────────────────────────── */
  .lang-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 4vw, 3.6rem); align-items: center; }
  @media (max-width: 880px) { .lang-grid { grid-template-columns: 1fr; } .lang-words { order: 1; } }
  .lang-words { display: grid; gap: 0.55rem; }
  .lang-words span {
    font-family: Fredoka, sans-serif; font-size: var(--step-3); line-height: 1.06;
    letter-spacing: -0.02em; color: var(--edge-deep);
  }
  .lang-words span:first-child { color: var(--forest); }
  .lang-note { font-weight: 800; color: var(--grass-deep); }

  /* ── Schools ────────────────────────────────────────────────────── */
  .schools-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(2rem, 4vw, 3.4rem); align-items: center; }
